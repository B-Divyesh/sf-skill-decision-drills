{
  "routes": [
    { "route": "/demo", "rewrite": "/index.html" },
    { "route": "/drills", "rewrite": "/index.html" },
    { "route": "/drills/*", "rewrite": "/index.html" },
    { "route": "/insights", "rewrite": "/index.html" },
    { "route": "/insights/*", "rewrite": "/index.html" },
    { "route": "/data", "rewrite": "/index.html" },
    { "route": "/about", "rewrite": "/index.html" },
    {
      "route": "/assets/decision-board-*.webp",
      "headers": {
        "cache-control": "public, max-age=3600, must-revalidate"
      }
    },
    {
      "route": "/assets/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/sw.js",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/manifest.webmanifest",
      "headers": {
        "cache-control": "public, max-age=3600, must-revalidate"
      }
    },
    {
      "route": "/",
      "headers": {
        "cache-control": "no-cache, must-revalidate"
      }
    },
    {
      "route": "/privacy/*",
      "headers": {
        "cache-control": "no-cache, must-revalidate"
      }
    },
    {
      "route": "/terms/*",
      "headers": {
        "cache-control": "no-cache, must-revalidate"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/not-found.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "DENY",
    "Cross-Origin-Opener-Policy": "same-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
    "Content-Security-Policy": "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; manifest-src 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self'"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
